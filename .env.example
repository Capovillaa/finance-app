# Local development only. `cp .env.example .env` and you are ready to run
# `npm run infra:up && npm run dev`.
#
# It is not a deployment template and cannot be used as one: the JWT secrets
# below are public (see the Auth section), and the Postgres password is the
# well-known default that docker-compose.yml uses. A deployment reads
# `.env.deploy.example` and `docker-compose.deploy.yml`, which share nothing
# with this file and default nothing that is a credential.

# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

# ---- Postgres ----
# A well-known password for a database of demo data, published on 127.0.0.1 by
# docker-compose.yml and reachable from nowhere else. The deployed composition
# requires a real one and publishes no port at all.
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_PORT=5432
DATABASE_URL=postgres://finance:finance@localhost:5432/finance
# Used only by the test suite (created/reset automatically)
TEST_DATABASE_URL=postgres://finance:finance@localhost:5432/finance_test
# Sent as Postgres session parameters on every pooled connection, so a
# runaway or forgotten-in-a-transaction query is killed by the server rather
# than holding its connection — and, once the pool is exhausted, everyone
# else's request — forever.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# How long a request may run before the client is given up on and answered
# 503. Looser than the statement timeout above, so an ordinary slow query
# times out at the database first; this is the backstop for a slow path that
# is not database-bound at all.
REQUEST_TIMEOUT_MS=20000

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# THESE THREE VALUES ARE PUBLIC. This file is committed to a public repository,
# so the bytes below are known to everyone: anyone holding JWT_ACCESS_SECRET can
# forge an access token for any user, anyone holding JWT_REFRESH_SECRET can
# compute the HMAC of any refresh or invitation token, and anyone holding
# EMAIL_TOKEN_SECRET can forge a password-reset or email-verification link for
# any address. They are here so that a fresh clone can run locally, and for
# nothing else.
#
# NODE_ENV=production refuses to boot on them, on anything shorter than 32
# characters, on anything that still looks like a placeholder, and on any two of
# the three sharing a value — see apps/api/src/config/production-policy.ts.
# Generate a separate real secret per variable and supply it through the
# deployment environment or a secret store, never through a copy of this file:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-insecure-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-insecure-refresh-secret-change-me
# HMAC key for password-reset and email-verification tokens — deliberately its
# own secret rather than reusing JWT_REFRESH_SECRET (which already signs both
# refresh tokens and invitation tokens; see M-11 in AUDIT_REPORT.md).
EMAIL_TOKEN_SECRET=dev-only-insecure-email-token-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# How long a requested account erasure waits before the maintenance job carries
# it out. Signing in during the window cancels it.
ACCOUNT_DELETION_GRACE_DAYS=7

# ---- Sign in with Google (optional) ----
# The OAuth client ID from Google Cloud Console: APIs & Services -> Credentials
# -> Create credentials -> OAuth client ID -> Web application. Not a secret —
# the browser sends it to Google to obtain a token in the first place — and
# there is deliberately no client *secret* anywhere: the browser-side Google
# Identity Services flow returns a signed ID token directly, which the API
# verifies against this same value as the token's audience.
#
# The client's **Authorized JavaScript origin** in that console must be exactly
# the origin the app is served from — http://localhost:5173 in development,
# PUBLIC_URL in a deployment. Google refuses the sign-in otherwise.
#
# Leave both blank to run password-only: the API answers /auth/google with
# `auth.googleNotConfigured` and the client renders no button at all.
GOOGLE_CLIENT_ID=
# The client's copy, read by Vite at build time. Same value; it is a separate
# variable because only names starting with VITE_ reach the bundle.
VITE_GOOGLE_CLIENT_ID=

# ---- Email (MailHog in local dev; UI at http://localhost:8025) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Finance App <no-reply@finance.local>"
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_SECONDS=60
# The everyday budget, charged to the signed-in user who spends it.
RATE_LIMIT_MAX_REQUESTS=300
# A looser per-address backstop, charged alongside it. A shared office address
# is ordinary; a flood from one address is not.
RATE_LIMIT_IP_MAX_REQUESTS=1200
# How many API instances share one Redis. Only used to divide the per-process
# fallback budget, so losing Redis does not multiply the advertised limit.
RATE_LIMIT_INSTANCES=1
# Credential attempts from one address per window...
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# ...and against one account from anywhere, which is the bound that survives an
# attacker rotating addresses. Counted over its own, longer window.
AUTH_RATE_LIMIT_MAX_PER_ACCOUNT=20
AUTH_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900

# ---- Network trust ----
# How much of `X-Forwarded-For` to believe. The header is client-supplied, so
# trusting it with nothing in front lets any caller mint a fresh rate-limit
# bucket per request. `false` trusts nothing; use the number of proxy hops in
# front of this process (`1` behind a single load balancer), `loopback`, or a
# comma-separated list of trusted addresses and subnets.
TRUST_PROXY=false
# Browser origins allowed to call the API with credentials. Defaults to
# WEB_BASE_URL; development additionally reflects whatever origin asks.
CORS_ORIGINS=

# ---- Currency ----
BASE_CURRENCY=BRL
# static          indicative BRL rates baked into the code; no network at all
# frankfurter     the ECB's daily reference rates, no API key required
# openexchangerates   needs EXCHANGE_RATE_API_KEY; the free plan quotes USD only
EXCHANGE_RATE_PROVIDER=static
# Overrides the provider's own endpoint, for a proxy or a mirror. Leave empty.
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_TIMEOUT_MS=8000

# ---- Jobs ----
ENABLE_SCHEDULER=true
