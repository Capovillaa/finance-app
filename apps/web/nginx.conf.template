# The client's HTTP server: static bundle, SPA fallback, security headers, and
# the `/api` proxy that keeps the browser on one origin.
#
# This file is the only place the security headers for the *document* can live.
# `helmet` on the API sets headers on JSON responses, which is worth doing and
# is not the same thing: a Content-Security-Policy, `X-Frame-Options` and HSTS
# only mean anything on the HTML a browser actually loads, and nothing was
# serving that HTML at all before this image existed.
#
# ---- Why this is a template, not a finished config -------------------------
#
# It is copied to `/etc/nginx/templates/default.conf.template`, and the nginx
# image's own entrypoint runs `envsubst` over it into `/etc/nginx/conf.d/` at
# container start. Exactly two names are substituted, API_UPSTREAM and
# NGINX_RESOLVER, and the Dockerfile gives both the values this repository's
# compose file needs — so a `docker compose` deployment sees the same config it
# always did and sets neither variable.
#
# Written without the `${…}` around them on purpose: envsubst does not know a
# comment from a directive, and a worked example in this header would be
# rewritten into the rendered config as nonsense.
#
# They exist because "where is the API" is not the same answer everywhere. In
# compose it is a container named `api` on a bridge network with Docker's DNS
# at 127.0.0.11. On a platform with no compose network — Fly's `.flycast`,
# Railway's `.railway.internal`, a Render private service — it is a different
# hostname resolved by a different, frequently IPv6-only, resolver. Both halves
# have to move together, which is why `NGINX_RESOLVER` is the resolver's whole
# argument list rather than just an address: `ipv6=off` is right for Docker and
# wrong for every platform whose private DNS is IPv6.
#
# `NGINX_ENVSUBST_FILTER` in the Dockerfile restricts substitution to those two
# names. Without it `envsubst` would also replace nginx's own `$host`, `$uri`
# and `$remote_addr` — with empty strings, since they are not environment
# variables — and the result parses cleanly while proxying to nowhere.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # nginx advertises its exact version in every response and on error pages,
    # which is free reconnaissance and buys nobody anything.
    server_tokens off;

    # ---- Security headers --------------------------------------------------
    #
    # `always` matters: without it these are attached to 2xx/3xx only, and an
    # error page — which is HTML, and is exactly where a clickjacking frame
    # would sit — would go out bare.
    #
    # The policy is tight because this app needs nothing exotic:
    #   default-src 'self'    nothing loads from anywhere else by default
    #   script-src 'self'     no inline script, no eval, no CDN
    #   style-src  'unsafe-inline'  MUI/emotion inject <style> tags at runtime;
    #                         this is the one relaxation, and it is a real one
    #   font-src   'self'     all three families are self-hosted via Fontsource,
    #                         so there is no Google Fonts origin to allow
    #   img-src    data: blob:  avatars are remote URLs; charts and downloads
    #                         build blob/data URLs client-side
    #   connect-src 'self'    the API is same-origin through the proxy below,
    #                         which is what makes this line able to be 'self'
    #   frame-ancestors 'none'  nothing may frame this app: the transfer and
    #                         delete flows are one click each
    #   form-action 'self'    a submitted form cannot be pointed elsewhere
    #   base-uri 'self'       a stray <base> cannot re-target every relative URL
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https: data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'" always;

    # Redundant with `frame-ancestors` for modern browsers, kept for older ones.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # This app asks for none of these, so it says so.
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    # HSTS. Two years, subdomains included, no `preload` — preloading is a
    # decision about a domain that cannot easily be undone, and it is not this
    # file's to make. Harmless over plain HTTP (browsers ignore it), so it does
    # not need a conditional it could get wrong.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml font/woff2;

    # ---- The API, on this same origin --------------------------------------
    #
    # Everything under /api goes to the API container. This is what lets the
    # refresh cookie be `SameSite=Lax` and the CSP's `connect-src` be `'self'`.
    location /api/ {
        # The upstream is held in an nginx variable rather than written
        # literally, and that is load-bearing in two ways:
        #
        # nginx resolves a literal `proxy_pass http://api:4000` **once, at
        # startup**, and caches that address for the life of the process — so
        # recreating the API container (any redeploy) leaves this one proxying
        # to an address nothing answers on, until someone restarts it. Through a
        # variable, resolution happens per request, against the `valid=` above.
        # Every platform this can deploy to reassigns the API's private address
        # on each release, so this is not a compose-only concern.
        #
        # It also makes the config parseable on its own: `nginx -t` outside the
        # compose network cannot resolve `api`, and CI runs exactly that check.
        #
        # A variable `proxy_pass` *requires* a `resolver`; there is no falling
        # back to the container's /etc/resolv.conf. That is why the two
        # substitutions below are a pair, and why neither is optional.
        resolver ${NGINX_RESOLVER};
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        # The API reads `req.ip` out of this to key its rate limiter, so it has
        # to be the real client rather than this container. It is only believed
        # because TRUST_PROXY=1 is set on the API service in the deployed
        # composition, and `$proxy_add_x_forwarded_for` appends rather than
        # trusting whatever the client claimed on its own.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;

        # A CSV export of a long period is a slow response, not a hung one.
        proxy_read_timeout 60s;
        # The API caps its own bodies at 1 MB; matching here means an oversized
        # upload is refused at the edge rather than proxied and then rejected.
        client_max_body_size 1m;
    }

    # ---- Static assets -----------------------------------------------------
    #
    # Vite fingerprints every built asset, so a hashed file is immutable: a new
    # build produces a new name rather than new content under the old one.
    location /assets/ {
        # One directive, not `expires 1y` *and* an add_header: those emit two
        # Cache-Control lines, which is legal and combines correctly but reads
        # like a mistake in every debugging session that follows.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        # `add_header` in a location block replaces the whole inherited set
        # rather than adding to it, so the security headers have to be repeated
        # here. Omitting them is the classic way a hardened site serves one
        # unprotected path.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https: data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        try_files $uri =404;
    }

    # The container's own liveness, distinct from the API's /health.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    # ---- The single-page app ------------------------------------------------
    #
    # Every unmatched path is a client route, so it gets index.html and React
    # Router decides. `index.html` itself must never be cached, or a browser
    # keeps asking for the JS bundle of a build that no longer exists.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https: data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    }
}
