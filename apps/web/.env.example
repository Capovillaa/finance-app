# Where the client sends API calls. Leave as the default relative path in
# development: Vite proxies /api to the API process (see vite.config.ts), which
# keeps the app on one origin so the HttpOnly refresh cookie works normally.
# In production point this at the deployed API, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Only used by the dev proxy. Change if the API is not on port 4000.
VITE_API_PROXY_TARGET=http://localhost:4000
