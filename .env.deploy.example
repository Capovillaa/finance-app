# Deployment configuration for docker-compose.deploy.yml.
#
#     cp .env.deploy.example .env.deploy      # then fill in every REQUIRED value
#     docker compose -f docker-compose.deploy.yml --env-file .env.deploy up -d --build
#
# This is a separate file from `.env` deliberately. `.env` is what
# `cp .env.example .env` produces, compose reads it automatically, and the JWT
# placeholders in it are published in a public repository — a development file
# reaching a production container is audit finding C-1 and is the reason the
# deployed composition names its variables instead of inheriting a file.
#
# Nothing here has a working default: every REQUIRED line makes compose refuse
# to start until it is filled in, and the API refuses a second time at boot if
# a secret is one it recognises as public.

# ---- REQUIRED: signing secrets --------------------------------------------
# Two different values, each generated separately:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production rejects anything under 32 characters, anything this repository has
# published, anything still shaped like a placeholder, and one value used twice.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- REQUIRED: data store credentials --------------------------------------
# Both end up inside a connection URL, so generate them from an alphabet that
# survives one — base64url or hex, no `@`, `:`, `/` or `#`:
#     node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Neither store publishes a port in the deployed composition; these guard the
# compose network itself, and the day someone adds a port they are what is left.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_USER=finance
POSTGRES_DB=finance

# ---- REQUIRED: mail --------------------------------------------------------
# There is no MailHog in the deployed composition, and the API will not boot
# without a host: mail carries workspace invitations, and the delivery path logs
# its failures rather than raising them, so a wrong host here loses invitations
# silently. Use a real provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Finance App <no-reply@example.com>"

# ---- REQUIRED: public URLs -------------------------------------------------
# WEB_BASE_URL is what invitation links point at, so it must be the address a
# recipient can actually open. API_BASE_URL is this API's own public address.
API_BASE_URL=https://api.example.com
WEB_BASE_URL=https://app.example.com

# ---- Network -------------------------------------------------------------
# Browser origins allowed to send credentialed requests. Defaults to
# WEB_BASE_URL; set it when the client is served from more than one host.
CORS_ORIGINS=
# `req.ip` is read out of `X-Forwarded-For`, a header the *client* sends, so
# this is a security setting rather than a deployment detail: set it to the
# number of proxy hops genuinely in front of the API (`1` behind a single load
# balancer). Left at `false`, the rate limiter is keyed on the socket address,
# which is correct when nothing is in front and wrong when something is.
TRUST_PROXY=false
# Where the API's port is published on the host. Loopback by default, on the
# assumption that a reverse proxy terminating TLS is what faces the internet.
API_BIND_ADDRESS=127.0.0.1
PORT=4000
# How many API instances share one Redis. Only used to divide the per-process
# rate-limit budget when Redis is unreachable, so losing it does not multiply
# the advertised limit by the size of the deployment.
RATE_LIMIT_INSTANCES=1

# ---- Application -----------------------------------------------------------
LOG_LEVEL=info
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BASE_CURRENCY=BRL
# static | frankfurter | openexchangerates — see CLAUDE.md section 5f.
EXCHANGE_RATE_PROVIDER=frankfurter
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=
