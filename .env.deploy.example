# Deployment configuration for docker-compose.deploy.yml.
#
#     cp .env.deploy.example .env.deploy      # then fill in every REQUIRED value
#     docker compose -f docker-compose.deploy.yml --env-file .env.deploy up -d --build
#
# This is a separate file from `.env` deliberately. `.env` is what
# `cp .env.example .env` produces, compose reads it automatically, and the JWT
# placeholders in it are published in a public repository — a development file
# reaching a production container is audit finding C-1 and is the reason the
# deployed composition names its variables instead of inheriting a file.
#
# Nothing here has a working default: every REQUIRED line makes compose refuse
# to start until it is filled in, and the API refuses a second time at boot if
# a secret is one it recognises as public.

# ---- REQUIRED: signing secrets --------------------------------------------
# Three different values, each generated separately:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production rejects anything under 32 characters, anything this repository has
# published, anything still shaped like a placeholder, and any two of the three
# sharing a value. EMAIL_TOKEN_SECRET signs password-reset and
# email-verification links; it is separate from JWT_REFRESH_SECRET on purpose —
# see M-11 in AUDIT_REPORT.md for why that secret should not pick up a third job.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMAIL_TOKEN_SECRET=

# ---- REQUIRED: data store credentials --------------------------------------
# Both end up inside a connection URL, so generate them from an alphabet that
# survives one — base64url or hex, no `@`, `:`, `/` or `#`:
#     node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Neither store publishes a port in the deployed composition; these guard the
# compose network itself, and the day someone adds a port they are what is left.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ---- TLS to Postgres and Redis (L-5 in AUDIT_REPORT.md) --------------------
# `docker-compose.deploy.yml` runs its own Postgres and Redis on the compose
# network's own private bridge, which nothing outside the host can reach
# — that is a real network boundary, not TLS, but it is the
# reason this file does not generate certificates for two containers talking
# to each other on the same box.
#
# If you point DATABASE_URL / REDIS_URL at a remote service instead — a
# managed Postgres or Redis reached over the internet, which is the natural
# next step once this stops being a single-box deployment — both `pg` and
# `ioredis` already speak TLS with no code change, verified against real
# TLS-enabled Postgres and Redis containers while this finding was closed:
#   - DATABASE_URL: append `?sslmode=verify-full` (a publicly-trusted CA,
#     which every managed provider's default certificate chains to, needs
#     nothing further; a private CA needs NODE_EXTRA_CA_CERTS below).
#   - REDIS_URL: use the `rediss://` scheme in place of `redis://`.
#   - A private/self-signed CA on either store: set
#     `NODE_EXTRA_CA_CERTS=/path/to/ca.pem` in the container environment —
#     Node's TLS stack applies it to both connections, since neither client
#     overrides the process-wide trust store by default.
POSTGRES_USER=finance
POSTGRES_DB=finance

# ---- Sign in with Google (optional) ----------------------------------------
# The OAuth client ID from Google Cloud Console: APIs & Services -> Credentials
# -> Create credentials -> OAuth client ID -> Web application. Its **Authorized
# JavaScript origin** must be exactly PUBLIC_URL below, or Google refuses the
# sign-in with an origin mismatch and the button does nothing.
#
# Not a secret, and there is no client secret to hold: the browser-side Google
# Identity Services flow hands back a signed ID token, and the API verifies it
# against this value as the audience. One variable, both halves.
#
# Leave it blank for password-only — the API refuses /auth/google and the
# client renders no button. Note that the client's copy is compiled into the
# bundle by Vite (`docker-compose.deploy.yml` passes it as a build argument),
# so changing this needs `up -d --build`, not a restart.
GOOGLE_CLIENT_ID=

# ---- REQUIRED: mail --------------------------------------------------------
# There is no MailHog in the deployed composition, and the API will not boot
# without a host: mail carries workspace invitations, and the delivery path logs
# its failures rather than raising them, so a wrong host here loses invitations
# silently. Use a real provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Finance App <no-reply@example.com>"

# ---- REQUIRED: the public URL ----------------------------------------------
# One URL, because the app is served from one origin: the `web` container is an
# nginx that serves the client and proxies /api to the API. That is a
# requirement rather than a layout preference — the refresh token is an
# HttpOnly `SameSite=Lax` cookie, which a browser will not send on a cross-site
# request, so a client on a different origin than the API loses every session
# fifteen minutes in. The API refuses to start in production if its two base
# URLs disagree, so there is one variable here and it fills both.
#
# It is also what invitation links point at, so it must be an address a
# recipient can actually open. Use https:// — the refresh cookie is `Secure`.
PUBLIC_URL=https://finance.example.com

# ---- Network -------------------------------------------------------------
# Browser origins allowed to send credentialed requests. Defaults to the public
# URL, which is correct for the same-origin deployment above.
CORS_ORIGINS=
# `req.ip` is read out of `X-Forwarded-For`, a header the *client* sends, so
# this is a security setting rather than a deployment detail: it is the number
# of proxies genuinely in front of the API. `1` is right for this composition —
# the `web` nginx is that one hop. Raise it only if you add proxies in front of
# `web`; lowering it to `false` makes every request look like it came from the
# nginx container and turns the per-address rate limit into one shared bucket.
TRUST_PROXY=1
# Where the app is published on the host. Loopback by default: something in
# front has to terminate TLS, because the app must be reached over HTTPS.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# The API, Postgres and Redis publish no port at all in the deployed
# composition. To look inside a running stack — psql, DBeaver, pgAdmin, curl
# against the API — add the debug overlay to the command rather than setting
# something here:
#
#     docker compose -f docker-compose.deploy.yml -f docker-compose.debug.yml \
#       --env-file .env.deploy up -d
#
# It publishes all three on 127.0.0.1 only, and a plain `up -d` without it
# takes them back down. From another machine, reach them through an SSH tunnel
# (`ssh -N -L 5432:127.0.0.1:5432 you@server`) rather than by widening the
# bind address. The variables it reads, all optional, all defaulting to
# loopback: API_BIND_ADDRESS/API_PORT, POSTGRES_BIND_ADDRESS/
# POSTGRES_PUBLISHED_PORT, REDIS_BIND_ADDRESS/REDIS_PUBLISHED_PORT.
# How many API instances share one Redis. Only used to divide the per-process
# rate-limit budget when Redis is unreachable, so losing it does not multiply
# the advertised limit by the size of the deployment.
RATE_LIMIT_INSTANCES=1

# ---- Application -----------------------------------------------------------
LOG_LEVEL=info
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Sent as Postgres session parameters, so a runaway or forgotten-in-a-
# transaction query is killed by the server rather than holding a connection
# forever. REQUEST_TIMEOUT_MS is the client-facing backstop, looser than the
# statement timeout so the database times out first on an ordinary slow query.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=20000
# How long a requested account erasure waits before it happens. Signing in
# during the window cancels it, so this is how long a mistaken — or coerced —
# deletion stays recoverable. The erasure itself is irreversible when it runs.
ACCOUNT_DELETION_GRACE_DAYS=7
BASE_CURRENCY=BRL
# static | frankfurter | openexchangerates — see `docs/decisions.md`,
# "Live exchange rates: one provider interface, and a fallback that cannot do harm".
EXCHANGE_RATE_PROVIDER=frankfurter
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=
