# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment. The two `*.example` files are committed and are the documented
# starting points — `.env.example` for development, `.env.deploy.example` for
# `docker-compose.deploy.yml`. Everything else in this family holds real
# credentials: this machine's database password and JWT secrets in `.env`, and a
# deployment's whole secret set in `.env.deploy`.
.env
.env.*
!.env.example
!.env.deploy.example

# Local Postgres data, if a bind mount is ever used instead of a named volume
infra/postgres/data/

# Ad-hoc scratch from load-testing sessions; not part of the project
.tmp/

# The pre-deployment security audit and the working task list. Deliberately
# untracked while findings are still open: the report names every unfixed one,
# with a file and a line, and this repository is public. CLAUDE.md section 7
# carries the checklist, which is the half that is safe to publish.
AUDIT_REPORT.md
to_do.txt

# A dump of every Phosphor export, generated while migrating the icon set.
# Regenerable from the package; not source.
apps/web/.phosphor-names.txt

# Editor and OS noise
.vscode/
.idea/
# Per-machine tool permissions, not project configuration
.claude/settings.local.json
# Agent skills installed by the `skills` CLI: third-party tooling for whoever is
# working on the repo, not part of the project. `.agents/` and `agent/` hold the
# files, `.claude/skills/` symlinks into them, `skills-lock.json` pins versions.
# Commit these instead if the team should all get the same skills.
.agents/
agent/
.claude/skills/
skills-lock.json
.DS_Store
Thumbs.db

# Logs and coverage
*.log
npm-debug.log*
coverage/
.vitest-reports/
